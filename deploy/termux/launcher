#!/data/data/com.termux/files/usr/bin/bash
set -u

APP_HOME="/root/.local/share/ofbackup"
HOST_APP_HOME="$HOME/.local/share/ofbackup"
HOST_CACHE="$HOME/.cache/ofbackup"
IMPORT_REQUEST_EXIT=42
APP_UPDATE_REQUEST_EXIT=43
SELECTED_TEMP=""
MAX_AUTH_SIZE=65536
UPDATE_STATUS="unknown"
DIRECT_UPDATE_URL="${OFBACKUP_UPDATE_SCRIPT_URL:-https://raw.githubusercontent.com/tacosandtypescript-debug/of-downloader/main/actualizar-termux.sh}"

cleanup_temp() {
    if [[ -n "$SELECTED_TEMP" ]]; then
        rm -f "$SELECTED_TEMP"
        SELECTED_TEMP=""
    fi
}

trap cleanup_temp EXIT
trap 'cleanup_temp; exit 130' INT TERM

run_cli_in_container() {
    local bind_spec="${1:-}"
    shift
    local stderr_temp
    # The cache is not guaranteed to exist on a clean Termux install.  Create
    # it before mktemp so the first invocation can open the menu successfully.
    if ! mkdir -p "$HOST_CACHE"; then
        echo "✗ No se pudo crear la caché temporal de OF Downloader: $HOST_CACHE" >&2
        return 2
    fi
    chmod 700 "$HOST_CACHE" 2>/dev/null || true
    stderr_temp="$(mktemp "$HOST_CACHE/ofbackup-stderr.XXXXXX")"
    local -a login_args=(login --shared-home ofbackup-debian)
    if [[ -n "$bind_spec" ]]; then
        login_args+=(--bind "$bind_spec")
    fi
    proot-distro "${login_args[@]}" -- \
        env "OFDOWNLOADER_PLATFORM=TERMUX" \
        "OFDOWNLOADER_UPDATE_STATUS=$UPDATE_STATUS" \
        "PYTHONUNBUFFERED=1" \
        "PYTHONIOENCODING=utf-8" \
        "$APP_HOME/.venv/bin/python" -u "$APP_HOME/ofbackup_cli.py" "$@" 2>"$stderr_temp"
    local status=$?
    if [[ -s "$stderr_temp" ]]; then
        echo "--- DIAGNÓSTICO (stderr) ---" >&2
        cat "$stderr_temp" >&2
        echo "--- FIN DIAGNÓSTICO ---" >&2
    fi
    rm -f "$stderr_temp"
    return "$status"
}

run_ofbackup() {
    run_cli_in_container "" "$@"
}

find_repo_dir() {
    local candidate
    for candidate in \
        "${OFDOWNLOADER_REPO:-}" \
        "$PWD" \
        "$HOME/of-downloader"; do
        if [[ -n "$candidate" && -d "$candidate/.git" ]]; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}

check_repository_update() {
    local repo
    repo="$(find_repo_dir)" || {
        printf 'repo-missing'
        return 0
    }
    if command -v timeout >/dev/null 2>&1; then
        timeout 6 git -C "$repo" fetch --quiet origin main </dev/null 2>/dev/null || {
            printf 'offline'
            return 0
        }
    elif ! git -C "$repo" fetch --quiet origin main </dev/null 2>/dev/null; then
        printf 'offline'
        return 0
    fi

    local current remote
    current="$(git -C "$repo" rev-parse HEAD 2>/dev/null)" || {
        printf 'error'
        return 0
    }
    remote="$(git -C "$repo" rev-parse origin/main 2>/dev/null)" || {
        printf 'error'
        return 0
    }
    if [[ "$current" == "$remote" ]]; then
        if [[ ! -f "$HOST_APP_HOME/ofbackup_cli.py" ]] || \
           ! cmp -s "$repo/ofbackup_cli.py" "$HOST_APP_HOME/ofbackup_cli.py" || \
           [[ ! -f "$HOST_APP_HOME/backend/models.py" ]] || \
           [[ ! -f "$HOST_APP_HOME/backend/queue/__init__.py" ]] || \
           [[ ! -f "$HOST_APP_HOME/frontend/progress.py" ]]; then
            printf 'available'
        else
            printf 'current'
        fi
    elif git -C "$repo" merge-base --is-ancestor "$current" "$remote" 2>/dev/null; then
        printf 'available'
    else
        printf 'diverged'
    fi
}

update_application_from_archive() {
    local updater_temp
    mkdir -p "$HOST_CACHE"
    chmod 700 "$HOST_CACHE" 2>/dev/null || true
    updater_temp="$(mktemp "$HOST_CACHE/ofbackup-update.XXXXXX.sh")" || {
        echo "✗ No se pudo crear el archivo temporal del actualizador."
        return 2
    }
    if ! command -v curl >/dev/null 2>&1; then
        echo "✗ Falta curl para obtener la actualización directa."
        echo "Ejecuta: pkg install -y curl"
        rm -f "$updater_temp"
        return 2
    fi
    echo "No hay una copia local del repositorio; usando actualización incremental…"
    if ! curl -fL --retry 3 --retry-delay 1 --connect-timeout 15 \
        "$DIRECT_UPDATE_URL" -o "$updater_temp"; then
        echo "✗ No se pudo obtener el actualizador desde GitHub."
        rm -f "$updater_temp"
        return 2
    fi
    chmod 700 "$updater_temp"
    if ! bash "$updater_temp"; then
        rm -f "$updater_temp"
        return 2
    fi
    rm -f "$updater_temp"
    return 0
}

update_application() {
    local repo
    if ! repo="$(find_repo_dir)"; then
        update_application_from_archive
        return $?
    fi

    echo
    echo "Actualizando OF Downloader desde GitHub…"
    if ! git -C "$repo" pull --ff-only origin main; then
        echo "✗ No se pudo actualizar sin modificar tus archivos locales."
        echo "Revisa el mensaje de Git anterior y vuelve a intentarlo."
        return 2
    fi

    echo "Comprobando herramientas de Termux…"
    if ! pkg install -y rclone termux-api >/dev/null 2>&1; then
        echo "AVISO: no se pudieron instalar rclone/termux-api automaticamente."
        echo "Google Drive o QR puede quedar pendiente. Ejecuta:"
        echo "  pkg install -y rclone termux-api"
    fi
    if ! pkg install -y qrencode >/dev/null 2>&1; then
        echo "AVISO: qrencode no esta disponible en este repositorio de Termux."
        echo "El QR es opcional; la aplicacion seguira funcionando."
    fi
    if ! proot-distro login --shared-home ofbackup-debian -- bash -lc \
        'apt-get update >/dev/null 2>&1 && apt-get install -y rclone >/dev/null 2>&1'; then
        echo "AVISO: no se pudo instalar rclone dentro de Debian."
        echo "Google Drive o QR puede quedar pendiente. Ejecuta:"
        echo "  proot-distro login --shared-home ofbackup-debian -- apt-get install -y rclone"
    fi
    if ! proot-distro login --shared-home ofbackup-debian -- bash -lc \
        'apt-get install -y qrencode >/dev/null 2>&1'; then
        echo "AVISO: qrencode no esta disponible dentro de Debian. El QR es opcional."
    fi

    local requirements_src=""
    if [[ -f "$repo/requirements/termux.txt" ]]; then
        requirements_src="$repo/requirements/termux.txt"
    elif [[ -f "$repo/requirements-termux.txt" ]]; then
        requirements_src="$repo/requirements-termux.txt"
    fi
    local launcher_src=""
    if [[ -f "$repo/deploy/termux/launcher" ]]; then
        launcher_src="$repo/deploy/termux/launcher"
    elif [[ -f "$repo/ofbackup" ]]; then
        launcher_src="$repo/ofbackup"
    fi

    local requirements_changed=0
    if [[ -z "$requirements_src" ]]; then
        echo "✗ El repositorio no contiene requirements/termux.txt."
        return 2
    fi
    if [[ ! -f "$HOST_APP_HOME/requirements-termux.txt" ]] || \
       ! cmp -s "$requirements_src" "$HOST_APP_HOME/requirements-termux.txt"; then
        requirements_changed=1
    fi

    mkdir -p "$HOST_APP_HOME"
    if [[ ! -f "$repo/ofbackup_cli.py" || ! -f "$repo/backend/models.py" || ! -f "$repo/frontend/progress.py" ]]; then
        echo "✗ El repositorio no contiene todos los componentes de OF Downloader."
        echo "Vuelve a clonar/actualizar el repositorio y reintenta."
        return 2
    fi
    if [[ -z "$launcher_src" ]]; then
        echo "✗ El repositorio no contiene el lanzador de Termux."
        return 2
    fi
    install -m 600 "$repo/ofbackup_cli.py" "$HOST_APP_HOME/ofbackup_cli.py"
    mkdir -p "$HOST_APP_HOME/backend" "$HOST_APP_HOME/frontend"
    if ! cp -R "$repo/backend/." "$HOST_APP_HOME/backend/" || \
       ! cp -R "$repo/frontend/." "$HOST_APP_HOME/frontend/"; then
        echo "✗ No se pudieron copiar los componentes backend/frontend."
        return 2
    fi
    chmod -R u=rwX,go= "$HOST_APP_HOME/backend" "$HOST_APP_HOME/frontend"
    if [[ ! -f "$HOST_APP_HOME/backend/models.py" || ! -f "$HOST_APP_HOME/backend/queue/__init__.py" || ! -f "$HOST_APP_HOME/frontend/progress.py" ]]; then
        echo "✗ La actualización quedó incompleta: faltan paquetes Python."
        return 2
    fi
    install -m 600 "$requirements_src" "$HOST_APP_HOME/requirements-termux.txt"
    install -m 755 "$launcher_src" "$PREFIX/bin/of"
    install -m 755 "$launcher_src" "$PREFIX/bin/ofbackup"

    if [[ "$requirements_changed" -eq 1 ]]; then
        echo "Actualizando componentes de Python…"
        if ! proot-distro login --shared-home ofbackup-debian -- \
            "$APP_HOME/.venv/bin/python" -m pip install --upgrade \
            -r "$APP_HOME/requirements-termux.txt"; then
            echo "✗ El código se actualizó, pero faltó actualizar componentes."
            echo "Ejecuta: bash $repo/instalar-termux.sh"
            return 2
        fi
    fi

    UPDATE_STATUS="current"
    echo "✓ OF Downloader actualizado. Reiniciando el menú…"
    return 0
}

run_selected_temp() {
    local selected="$1"
    if [[ ! -f "$selected" || ! -s "$selected" ]]; then
        echo "✗ El archivo temporal de acceso no existe o está vacío." >&2
        return 2
    fi

    # No entregues a Debian la ruta absoluta de Termux.  --shared-home monta
    # el HOME en /root, pero la ruta /data/data/... no tiene por qué existir
    # dentro del rootfs.  En su lugar hacemos un bind explícito y efímero a
    # /tmp, una ubicación presente en cualquier Debian de proot-distro. Así
    # Python siempre lee exactamente los bytes que devolvió Android.
    local container_path
    container_path="/tmp/$(basename -- "$selected")"
    run_cli_in_container "$selected:$container_path" importar-archivo "$container_path"
}

import_host_file() {
    local source="$1"
    # Permite rutas pegadas con comillas y la abreviatura ~/... sin usar eval.
    source="${source#\"}"
    source="${source%\"}"
    source="${source#\'}"
    source="${source%\'}"
    if [[ "$source" == "~/"* ]]; then
        source="$HOME/${source:2}"
    fi
    if [[ ! -f "$source" ]]; then
        echo "✗ No encuentro el archivo: $source"
        return 2
    fi
    if [[ ! -s "$source" ]]; then
        echo "✗ El archivo está vacío. Vuelve a exportarlo desde la extensión."
        return 2
    fi
    local size
    size="$(wc -c <"$source")"
    if ((size > MAX_AUTH_SIZE)); then
        echo "✗ El archivo es demasiado grande para ser un archivo de acceso."
        return 2
    fi

    mkdir -p "$HOST_CACHE"
    local selected
    selected="$(mktemp "$HOST_CACHE/auth-import.XXXXXX.json")"
    SELECTED_TEMP="$selected"
    if ! install -m 600 -- "$source" "$selected"; then
        rm -f "$selected"
        SELECTED_TEMP=""
        echo "✗ No se pudo copiar el archivo de acceso a la caché temporal."
        return 2
    fi
    echo "Archivo preparado: $(basename -- "$source") ($(wc -c <"$selected") bytes)."
    run_selected_temp "$selected"
    local status=$?
    rm -f "$selected"
    SELECTED_TEMP=""
    return "$status"
}

manual_import_prompt() {
    local source=""
    echo "Puedes pegar la ruta completa del JSON en cualquier carpeta accesible por Termux."
    echo "Ejemplo: ~/storage/shared/Mis archivos/OFBackup-auth.json"
    if [[ -r /dev/tty ]]; then
        IFS= read -r -p "Ruta (Enter para cancelar) › " source </dev/tty || true
    else
        IFS= read -r -p "Ruta (Enter para cancelar) › " source || true
    fi
    if [[ -z "${source//[[:space:]]/}" ]]; then
        echo "No se seleccionó ningún archivo. No se usará otro JSON automáticamente."
        return 2
    fi
    import_host_file "$source"
}

select_and_import() {
    if ! command -v termux-storage-get >/dev/null 2>&1; then
        echo "✗ Falta Termux:API para abrir el selector de Android."
        echo "También puedes importar una ruta manual sin usar el selector."
        manual_import_prompt
        return $?
    fi

    mkdir -p "$HOST_CACHE"
    local selected
    selected="$(mktemp "$HOST_CACHE/auth-import.XXXXXX.json")"
    SELECTED_TEMP="$selected"
    chmod 600 "$selected"

    echo "Abriendo el selector de Android…"
    echo "Elige OFBackup-auth.json desde cualquier carpeta del dispositivo."
    if ! termux-storage-get "$selected"; then
        rm -f "$selected"
        SELECTED_TEMP=""
        echo "✗ Android no pudo entregar el archivo seleccionado."
        echo "No se usará automáticamente un JSON antiguo de Descargas."
        manual_import_prompt
        return $?
    fi

    if [[ ! -s "$selected" ]]; then
        rm -f "$selected"
        SELECTED_TEMP=""
        echo "✗ Android entregó un archivo vacío."
        echo "No se usará automáticamente un JSON antiguo de Descargas."
        manual_import_prompt
        return $?
    fi

    echo "Archivo recibido desde Android: $(wc -c <"$selected") bytes."
    run_selected_temp "$selected"
    local status=$?
    if [[ "$status" -ne 0 ]]; then
        echo "✗ Error al importar las credenciales (código $status)."
        echo "  Revisa que el archivo OFBackup-auth.json sea válido y reciente."
        echo "  Si el problema persiste, ejecuta: of diagnostico"
    fi
    rm -f "$selected"
    SELECTED_TEMP=""
    return "$status"
}

if [[ "${1:-}" == "importar" ]]; then
    if [[ -n "${2:-}" ]]; then
        import_host_file "$2"
    else
        select_and_import
    fi
    exit $?
fi

case "${1:-menu}" in
    menu|actualizar-app|update-app)
        UPDATE_STATUS="$(check_repository_update)"
        ;;
esac

while true; do
    run_ofbackup "$@"
    status=$?
    if [[ "$status" -eq "$APP_UPDATE_REQUEST_EXIT" ]]; then
        if update_application; then
            set -- menu
            continue
        fi
        echo "Pulsa Enter para volver al menú…"
        read -r _ || true
        set -- menu
        continue
    fi
    if [[ "$status" -ne "$IMPORT_REQUEST_EXIT" ]]; then
        exit "$status"
    fi
    select_and_import
    status=$?
    if [[ "$status" -ne 0 ]]; then
        echo "Volviendo al menú…"
    fi
    set -- menu
done
